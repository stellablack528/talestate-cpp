#include <windows.h>
#define IDI_TALESTATE_ICON 101

IDI_TALESTATE_ICON ICON "../../assets/brand/talestate.ico"

1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TaleState Open Source\0"
            VALUE "FileDescription", "TaleState C++ text RPG engine\0"
            VALUE "FileVersion", "0.1.1\0"
            VALUE "InternalName", "TaleState\0"
            VALUE "OriginalFilename", "TaleState.exe\0"
            VALUE "ProductName", "TaleState C++\0"
            VALUE "ProductVersion", "0.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
